# Port server backend
PORT=5000

# Untuk pengembangan lebih lanjut (opsional, belum dipakai di MVP ini)
# OPENAI_API_KEY=

# Batas halaman hasil pencarian per keyword di Glints GraphQL.
# Default 1 supaya satu request tetap ringan; hard cap di code = 20.
MAX_PAGES_PER_KEYWORD=1

# Jumlah job per halaman GraphQL. Glints saat ini menerima sampai 30.
GLINTS_PAGE_SIZE=30

# Endpoint GraphQL internal yang dipakai search Glints saat ini. Jarang perlu diubah.
# GLINTS_GRAPHQL_URL=https://glints.com/api/v2-alc/graphql

# Jeda dasar (ms) antar request scraping agar tidak membebani Glints (jeda aktual diacak +/-35%)
SCRAPE_DELAY_MS=500

# Lowongan yang diposting lebih lama dari N hari ini tidak akan disertakan
MAX_POSTING_AGE_DAYS=5

# Jumlah maksimum kandidat teratas (per keyword run) yang akan diperkaya dengan deskripsi
# LENGKAP dari halaman detail Glints (bukan semua job, supaya tidak membebani server Glints)
DESCRIPTION_ENRICH_LIMIT=3

# (Opsional) URL API/sumber data UMR/UMK/UMP terpercaya yang mengembalikan JSON
# berbentuk { "nama kota atau provinsi": angka_umr, ... }. Kalau diisi, ini jadi sumber
# UTAMA (dengan cache 24 jam); kalau kosong atau gagal diakses, otomatis fallback ke
# tabel statis di backend/services/umrService.js.
# UMR_API_URL=https://contoh-sumber-umr.go.id/api/umr.json

# Maksimum keyword yang dipakai dalam satu request. Untuk Vercel Hobby, 5 lebih aman.
MAX_KEYWORDS=5

# Maksimum search Playwright yang berjalan bersamaan di satu instance backend.
MAX_CONCURRENT_SEARCHES=1

# Opsional: daftar origin frontend dipisahkan koma. Kosong = izinkan semua origin (tanpa credentials).
# CORS_ORIGIN=http://localhost:5173

# --- Kalau backend di-deploy ke Vercel/serverless, kecilkan beban per request: ---
# MAX_KEYWORDS=5
# MAX_PAGES_PER_KEYWORD=1
# DESCRIPTION_ENRICH_LIMIT=3
# SCRAPE_DELAY_MS=500
